# =============================================================================
# Duty — configuration
# Copy to `.env` and fill in only what you need. Every value is optional;
# Duty boots with a local SQLite database and a deterministic "local brain",
# so you can run it end-to-end before plugging in any paid service.
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=12000
HOST=0.0.0.0
# Public base URL of this Duty instance (used for webhook URLs + absolute links)
PUBLIC_URL=https://work-1-lhlqtwsunnoxqxuw.prod-runtime.all-hands.dev
# Comma-separated allowed CORS origins, or * for any
CORS_ORIGIN=*

# --- Admin auth -------------------------------------------------------------
# Shared admin token for the REST API + dashboard. CHANGE THIS.
ADMIN_TOKEN=duty-dev-token
# Secret used to sign web-chat session cookies
SESSION_SECRET=change-me-session-secret

# --- Storage: bring your own database ---------------------------------------
# sqlite | postgres | supabase | firebase | memory
DUTY_DB=sqlite
# sqlite (default): file path relative to the process cwd
SQLITE_PATH=./data/duty.sqlite
# postgres (also works for Neon, Supabase Postgres, RDS, ...)
DATABASE_URL=
# supabase (uses the PostgREST REST API with a service-role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# firebase (Realtime Database)
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- AI: bring your own key -------------------------------------------------
# Provider: openai | anthropic | gemini | openrouter | ollama | custom
AI_PROVIDER=openai
AI_API_KEY=
# Override the model (defaults are sensible per provider)
AI_MODEL=
# Override the base URL (Ollama, Azure, a proxy, vLLM, LM Studio, ...)
AI_BASE_URL=
# Embeddings provider: auto | openai | gemini | hash
EMBEDDINGS_PROVIDER=auto

# --- WhatsApp ---------------------------------------------------------------
# Cloud API (Meta) — set these to enable the official channel
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=duty-verify
# For any other gateway (Twilio, 360dialog, Baileys bridge, ...):
# point it at POST /webhooks/whatsapp and set a shared secret here.
WHATSAPP_WEBHOOK_SECRET=

# --- Outbound email (optional) ---------------------------------------------
SMTP_URL=
EMAIL_FROM=Duty <hello@duty.local>

# --- Behaviour --------------------------------------------------------------
# Currency used for pricing/analytics
DUTY_CURRENCY=USD
# Auto-reply to inbound messages without human review
AUTOREPLY=true
# Confidence below which Duty escalates to a human (0..1)
ESCALATION_THRESHOLD=0.35
