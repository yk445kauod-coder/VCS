{
  "name": "duty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Duty \u2014 an agentic commerce & customer-ops system that turns WhatsApp, webhooks and chat into revenue. BYOK, bring-your-own-DB, self-hosted.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run typecheck",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/server/index.ts",
    "seed": "tsx src/server/scripts/seed.ts",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "docker:build": "docker build -t duty .",
    "docker:run": "docker run --rm -p 8787:8787 --env-file .env duty"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "firebase": "^10.13.2",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.451.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
